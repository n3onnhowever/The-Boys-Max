# Only build/runtime inputs may enter the Docker context.
# Keep evidence, private inputs and repository metadata outside the image.
**
!package.json
!package-lock.json
!.npmrc
!tsconfig.json
!tsconfig.build.json
!tsconfig.pure.json
!apps/
!apps/**
!packages/
!packages/**
!modules/
!modules/**
!tests/
!tests/**
!scripts/
!scripts/**
!migrations/
!migrations/**
!patches/
!patches/**
!assets/
!assets/**
!licenses/
!licenses/**

# Re-exclude local/generated material even inside an allowed source directory.
**/node_modules
**/dist
**/coverage
**/.git
**/.secrets
**/.env*
**/*.log
**/*.zip
**/*.sqlite
**/*.sqlite3
**/*.db
**/.runtime
**/.run-evidence
**/.playwright
**/.browser-output
**/playwright-report
**/blob-report
**/test-results
**/test-downloads
**/.idea
**/.history
**/.DS_Store
**/Thumbs.db
**/desktop.ini
**/*.local
**/*.tmp
**/*.swp
**/*.swo
