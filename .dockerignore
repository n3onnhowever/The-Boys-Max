# Docker context for the build and isolated Compose test services.
**
!Dockerfile
!.dockerignore
!amvera.yaml
!package.json
!package-lock.json
!.npmrc
!tsconfig.json
!tsconfig.build.json
!tsconfig.pure.json
!apps/
!apps/**
!packages/
!packages/**
!modules/
!modules/**
!tests/
!tests/**
!scripts/
!scripts/**
!migrations/
!migrations/**
!patches/
!patches/**
!licenses/
!licenses/**
!certs/
!certs/russian-trusted-root-ca.crt
!certs/README.md

# Never send local output or private configuration.
**/node_modules
**/dist
**/coverage
**/.git
**/.env*
**/.secrets
**/.runtime
**/.run-evidence
**/artifacts
**/screenshots
**/logs
**/presentation-packs
**/*.log
**/*.zip
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.tmp
**/*.local
**/.playwright
**/.browser-output
**/playwright-report
**/blob-report
**/test-results
**/test-downloads
**/.idea
**/.history
**/.DS_Store
**/Thumbs.db
**/desktop.ini
