# Do not commit real values. The test compose generates private random HMAC/escrow/bot fixtures in a named volume.
APP_MODE=hybrid
PUBLIC_ORIGIN=https://replace-with-approved-origin.example
COOKIE_PROFILE=LAX_FIRST_PARTY
MAX_INGRESS_MODE=WEBHOOK
DATABASE_URL=
REDIS_URL=
SESSION_KEY=
ESCROW_KEY=
BOT_TOKEN=
# Separate random secret (32–256 A-Z/a-z/0-9/_/-); never reuse BOT_TOKEN.
MAX_WEBHOOK_SECRET=
# Legacy WEBHOOK_SECRET is accepted only for existing local test runtime files.
# Deployment URL attached to this bot in MAX; leave empty until approved.
POVOD_MINIAPP_URL=
# Published policy and about/terms/support pages, supplied by the owner.
POVOD_PRIVACY_URL=
POVOD_ABOUT_URL=
CREDENTIAL_SCOPE=
# Deliberately empty: only after dependency, security, real DB/Redis/governor, MAX and CA gates are reviewed.
MAX_BOT_USERNAME=
ALLOWED_SOURCE_ORIGINS=
AI_EXTERNAL_ENABLED=false
MAP_EXTERNAL_ENABLED=false
LIVE_GATE=
# NODE_EXTRA_CA_CERTS must reference a separately verified PEM, only if needed by the approved MAX TLS chain.
# Never use NODE_TLS_REJECT_UNAUTHORIZED=0.

# Reviewed curated source allowlist for the prepared catalog.
CURATED_SOURCE_HOSTS=
# Optional one-time outbound arm identifier; set only after delivery review.
POVOD_OUTBOUND_ARM_ID=
# Private GigaChat Authorization key; leave blank while external AI is disabled.
GIGACHAT_AUTH_KEY=
